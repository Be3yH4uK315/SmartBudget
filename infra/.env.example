COMPOSE_PROJECT_NAME=smartbudget

API_GATEWAY_HOST_PORT=80
FRONTEND_URL=http://127.0.0.1:3000
REDIS_HOST_PORT=6379
ZOOKEEPER_HOST_PORT=2181
KAFKA_HOST_PORT=9092

AUTH_POSTGRES_HOST_PORT=5433
CLASS_POSTGRES_HOST_PORT=5434
TRANSACTIONS_POSTGRES_HOST_PORT=5435
GOALS_POSTGRES_HOST_PORT=5436
NOTIFICATION_POSTGRES_HOST_PORT=5437
BUDGETS_POSTGRES_HOST_PORT=5438

AUTH_SERVICE_HOST_PORT=8000
CLASS_SERVICE_HOST_PORT=8001
GOALS_SERVICE_HOST_PORT=8002
NOTIFICATION_SERVICE_HOST_PORT=8003
TRANSACTIONS_SERVICE_HOST_PORT=8004
BUDGETS_SERVICE_HOST_PORT=8005

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=password
AUTH_POSTGRES_DB=auth_db
CLASS_POSTGRES_USER=postgres
CLASS_POSTGRES_PASSWORD=password
CLASS_POSTGRES_DB=class_db
TRANSACTIONS_POSTGRES_USER=postgres
TRANSACTIONS_POSTGRES_PASSWORD=password
TRANSACTIONS_POSTGRES_DB=transactions_db
BUDGETS_POSTGRES_USER=postgres
BUDGETS_POSTGRES_PASSWORD=password
BUDGETS_POSTGRES_DB=budgets_db
GOALS_POSTGRES_USER=postgres
GOALS_POSTGRES_PASSWORD=password
GOALS_POSTGRES_DB=goals_db
NOTIFICATION_POSTGRES_USER=postgres
NOTIFICATION_POSTGRES_PASSWORD=password
NOTIFICATION_POSTGRES_DB=notification_db

ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENERS=INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:29092,EXTERNAL://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
ALLOW_PLAINTEXT_LISTENER=yes
